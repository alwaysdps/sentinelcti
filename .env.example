# SentinelCTI configuration.
#
# Copy to `backend/.env` (or the repository root) and adjust. Never commit a
# real .env -- it is git-ignored for that reason. Every value below is a
# placeholder; none of them is a working credential.

# --- General --------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database -------------------------------------------------------------
# SQLite is the zero-config default and needs nothing else set.
DATABASE_URL=sqlite:///./sentinelcti.db

# --- Supabase / PostgreSQL -------------------------------------------------
# Switching backends requires no code change; every query goes through the ORM.
# Copy the URI from: Supabase → Project Settings → Database → Connection string
# → URI, then change the "postgresql://" prefix to "postgresql+psycopg://" so
# SQLAlchemy selects the psycopg 3 driver.
#
# Supabase offers three endpoints. Prefer the TRANSACTION POOLER:
#
#   Transaction pooler (port 6543) — recommended. IPv4, scales well. The app
#   auto-detects it and disables prepared statements, which PgBouncer's
#   transaction mode cannot support:
#     DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
#   Session pooler (port 5432, same host) — IPv4, behaves like a direct
#   connection. Use if you need session-level features such as LISTEN/NOTIFY.
#
#   Direct (db.<project-ref>.supabase.co:5432) — IPv6-only on current
#   projects, so it fails on IPv4-only hosts and most CI runners.
#
# Two things that cause almost every failed first attempt:
#   * The pooler username is "postgres.<project-ref>", NOT plain "postgres".
#   * If the password contains @ : / ? # or %, percent-encode it in the URL
#     (@ becomes %40, # becomes %23, and so on).
#
# Verify before starting the app:  python -m scripts.check_db --create

DATABASE_SSLMODE=require
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Leave unset to auto-detect from the port. Only set this if the heuristic
# misreads an unusual topology.
# DATABASE_TRANSACTION_POOLER=true

# --- CORS -----------------------------------------------------------------
# Comma-separated allowed origins. Never use "*" -- the moment authentication
# is added, a wildcard becomes a credential-leaking hole.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
# Quarantine directory. Must be outside any statically served path so an
# uploaded sample can never be fetched back over HTTP.
UPLOAD_DIR=./var/quarantine
# Discard sample bytes once hashes and metadata have been extracted. Keeping
# them only increases blast radius; the intelligence value is in the hashes.
DELETE_UPLOADS_AFTER_ANALYSIS=true
MAX_STRINGS_EXTRACTED=2000

# --- Analysis resource limits ---------------------------------------------
# Availability is part of the safety model. A sample that makes the analyzer
# burn unbounded CPU takes the service down as effectively as one that executes
# code, and needs no exploit to do it. These bound that.

# Cooperative deadline for one file's static analysis. Exceeding it produces a
# truncated, clearly-labelled report rather than a hung worker.
FILE_ANALYSIS_TIMEOUT_SECONDS=10.0

# Simultaneous file analyses. Each holds a worker thread and ~1 MB of buffer.
MAX_CONCURRENT_FILE_ANALYSES=4

# Ceiling on bytes resident in quarantine. Samples are deleted right after
# analysis, so this is only reached by concurrent uploads; it stops a burst
# from filling the disk.
MAX_QUARANTINE_BYTES=268435456

# --- Optional access gate ---------------------------------------------------
# Empty (the default) = no gate, which is correct on localhost.
#
# Set this BEFORE publishing the app through a tunnel or any public URL. The
# API has a DELETE endpoint and a real database behind it, so an ungated public
# instance can be emptied by anyone who finds the link.
#
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This is a single shared secret, not user accounts: it identifies no one and
# cannot be revoked per person. Right for a temporary demo; for anything
# lasting, use Cloudflare Access (README section 12.5).
ACCESS_TOKEN=

# Which HTTP methods require the token. "*" (default) protects everything.
#
#   ACCESS_PROTECTED_METHODS=DELETE
#     Site fully open to everyone -- anyone can browse and submit -- but only
#     a token holder can delete stored analyses. The right setting for a
#     public demo you do not want wiped.
#
#   ACCESS_PROTECTED_METHODS=POST,PUT,PATCH,DELETE
#     Reports readable by anyone; submitting and deleting need the token.
ACCESS_PROTECTED_METHODS=*

# --- Reverse proxy / CDN (Cloudflare) --------------------------------------
# Forwarding headers are set by whoever sends the request. Directly exposed to
# the internet they are attacker-controlled strings, so they are honoured ONLY
# when the socket peer -- which cannot be forged over TCP -- is a proxy listed
# here. Empty (the default) means headers are ignored entirely and the socket
# peer is always used, so the safe configuration is the one you get by default.
#
# Behind Cloudflare with PROXIED DNS (origin exposed, orange cloud). The
# `cloudflare` token expands to the published edge ranges:
#
#   TRUSTED_PROXIES=cloudflare
#   CLIENT_IP_HEADER=cf-connecting-ip
#
# Behind a CLOUDFLARE TUNNEL the peer is the local cloudflared process, NOT a
# Cloudflare edge address -- so 'cloudflare' would match nothing and every
# client would be attributed to cloudflared itself. Trust where cloudflared
# connects from instead:
#
#   TRUSTED_PROXIES=127.0.0.1/32      # cloudflared on the host
#   TRUSTED_PROXIES=172.16.0.0/12     # cloudflared as a Compose service
#   CLIENT_IP_HEADER=cf-connecting-ip
#
# The Settings page reports the resolved source, so you can confirm rather
# than guess.
#
# Cloudflare plus an internal load balancer:
#   TRUSTED_PROXIES=cloudflare,10.0.0.0/8
#
# A generic reverse proxy (nginx, Traefik, a cloud LB):
#   TRUSTED_PROXIES=10.0.0.0/8
#   CLIENT_IP_HEADER=x-forwarded-for
#
# Refresh the pinned Cloudflare ranges with:
#   python -m scripts.refresh_cloudflare_ips --write
TRUSTED_PROXIES=
CLIENT_IP_HEADER=

# --- Retention ------------------------------------------------------------
# History is per browsing session and disposable. The browser drops its
# workspace key when the tab closes and asks the API to delete the rows on the
# way out -- but an unload request is best-effort, so this is the backstop that
# makes "erased when you leave" true rather than aspirational.
#
# Without it, every abandoned session leaves rows nobody holds a key to:
# invisible to everyone, deletable by nobody, accumulating forever.
#
# Measured from when a row was created, not from last use, so a session left
# open longer than this loses its earliest analyses. Set 0 to keep everything
# (single-user local instances, or a deployment that wants durable history).
ANALYSIS_RETENTION_HOURS=24
# How often one process re-runs the sweep. It rides on write traffic; there is
# no scheduler here to hang it off.
RETENTION_SWEEP_INTERVAL_SECONDS=300

# --- Rate limiting --------------------------------------------------------
# In-process limiter: correct for a single worker. Running multiple workers or
# replicas requires a shared store (Redis) — see the roadmap.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Network behaviour ----------------------------------------------------
# Passive DNS asks the configured resolver about a name; it never contacts the
# indicator itself, so it is safe to leave on.
ENABLE_DNS_LOOKUPS=true
DNS_TIMEOUT_SECONDS=3.0

# Fetching a submitted URL would send traffic TO a suspected malicious host,
# alerting its operator that it is under investigation and pulling hostile
# content onto the analysis machine. Off by default and left off by the MVP.
ENABLE_ACTIVE_URL_FETCH=false

# --- Threat intelligence providers ----------------------------------------
# Comma-separated. "local" is the offline heuristic engine and needs no key.
ENABLED_PROVIDERS=local

# Phase 2 integrations. Leave blank to keep the provider disabled; the platform
# is fully functional with no external provider at all.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- Docker Compose (PostgreSQL profile) ----------------------------------
# POSTGRES_PASSWORD=change-me-before-use
